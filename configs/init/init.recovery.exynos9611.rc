on init
    write /proc/sys/kernel/hung_task_timeout_secs 0

    # Set sys.usb.configfs=1 during `init` so the
    # `on fs && property:sys.usb.configfs=1` block in
    # /system/etc/init/hw/init.rc (which mounts configfs at /config and
    # creates /config/usb_gadget/g1/...) is reached during the fs stage.
    setprop sys.usb.configfs 1
    setprop sys.usb.config adb
